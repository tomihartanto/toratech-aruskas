generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
}
model User {
  id Int @id @default(autoincrement())
  username String @unique
  name String
  passwordHash String
  role String @default("user")
  active Boolean @default(true)
  createdAt DateTime @default(now())
  sessions Session[]
  resets PasswordReset[]
  categories Category[]
  transactions Transaction[]
  budgets Budget[]
}
model Session {
  tokenHash String @id
  userId Int
  expiresAt DateTime
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}
model Invite {
  id Int @id @default(autoincrement())
  username String
  tokenHash String @unique
  expiresAt DateTime
  usedAt DateTime?
  createdAt DateTime @default(now())
}
model PasswordReset {
  tokenHash String @id
  userId Int
  expiresAt DateTime
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}
model LoginAttempt {
  key String @id
  count Int @default(0)
  expiresAt DateTime
}
model Category {
  id Int @id @default(autoincrement())
  userId Int?
  name String
  type String
  icon String @default("tag")
  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  budgets Budget[]
  @@unique([userId, name])
  @@unique([id, userId])
}
model Transaction {
  id Int @id @default(autoincrement())
  userId Int
  type String
  amount Decimal @db.Decimal(12, 2)
  categoryId Int
  note String @default("")
  date DateTime @db.Date
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId, userId], references: [id, userId])
  @@index([userId, date])
}
model Budget {
  id Int @id @default(autoincrement())
  userId Int
  categoryId Int
  month String
  limitAmount Decimal @db.Decimal(12, 2)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId, userId], references: [id, userId])
  @@unique([categoryId, month])
  @@index([userId])
}
